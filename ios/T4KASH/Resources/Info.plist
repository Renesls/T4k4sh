<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>es</string>
	<key>CFBundleDisplayName</key>
	<string>T4KASH</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- URL base de la API. Se resuelve desde el build setting T4KASH_API_BASE_URL,
	     configurable por esquema o desde xcodebuild. No contiene secretos. -->
	<key>T4KASHAPIBaseURL</key>
	<string>$(T4KASH_API_BASE_URL)</string>

	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>BrandBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>

	<!-- Permisos. Las cadenas se muestran al usuario en el diálogo del sistema. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>T4KASH usa tu ubicación para mostrarte oportunidades presenciales cercanas, tareas rápidas del radar y para ubicar en el mapa las tareas que publiques.</string>
	<key>NSCameraUsageDescription</key>
	<string>T4KASH usa la cámara para que puedas fotografiar comprobantes de entrega y documentos de verificación estudiantil.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>T4KASH accede a tus fotos para que puedas adjuntar imágenes a tus tareas, entregas y verificaciones.</string>

	<!-- Solo HTTPS. Ningún dominio con excepción de transporte. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
</dict>
</plist>
